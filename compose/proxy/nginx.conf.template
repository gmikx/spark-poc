limit_req_zone $binary_remote_addr zone=admin:10m rate=20r/s;

map $http_upgrade $connection_upgrade { default upgrade; '' close; }

server {
    listen 80 default_server;
    return 301 https://$host$request_uri;
}

server {
    listen 443 ssl default_server;
    http2 on;
    ssl_certificate     /certs/tls.crt;
    ssl_certificate_key /certs/tls.key;
    ssl_protocols TLSv1.2 TLSv1.3;
    client_max_body_size 200M;

    # zwykłe HTTP wysłane na port TLS (np. tunel na inny port) -> przekierowanie na HTTPS
    error_page 497 =301 https://$http_host$request_uri;

    # metryki huba tylko dla Prometheusa w sieci Dockera
    location ^~ /hub/metrics {
        return 404;
    }

    location / {
        resolver 127.0.0.11 valid=10s;
        set $hub http://jupyterhub:8000;
        proxy_pass $hub;
        proxy_http_version 1.1;
        proxy_set_header Host $http_host;
        proxy_set_header X-Real-IP $remote_addr;
        proxy_set_header X-Forwarded-For $proxy_add_x_forwarded_for;
        proxy_set_header X-Forwarded-Proto $scheme;
        proxy_set_header Upgrade $http_upgrade;
        proxy_set_header Connection $connection_upgrade;
        proxy_read_timeout 3600s;
        proxy_send_timeout 3600s;
        proxy_buffering off;
    }

    # Panele administracyjne pod /admin/: logowanie kontem LDAP administratora (bramka admin-auth)
    location = /_auth {
        internal;
        resolver 127.0.0.11 valid=10s;
        set $auth http://admin-auth:8080;
        proxy_pass $auth;
        proxy_pass_request_body off;
        proxy_set_header Content-Length "";
        proxy_set_header X-Real-IP $remote_addr;
    }

    location = /admin { return 301 /admin/; }
    location ^~ /admin/ {
        resolver 127.0.0.11 valid=10s;
        limit_req zone=admin burst=40 nodelay;
        auth_request /_auth;
        auth_request_set $webuser $upstream_http_x_webauth_user;

        location = /admin/ { return 302 /admin/grafana/; }

        location ^~ /admin/grafana/ {
            set $gf http://grafana:3000;
            proxy_pass $gf;
            proxy_http_version 1.1;
            proxy_set_header Host $http_host;
            proxy_set_header X-WEBAUTH-USER $webuser;
            proxy_set_header X-Forwarded-Proto $scheme;
            proxy_set_header Upgrade $http_upgrade;
            proxy_set_header Connection $connection_upgrade;
        }

        location ^~ /admin/prometheus/ {
            rewrite ^/admin/prometheus/(.*)$ /$1 break;
            proxy_pass http://10.78.0.5:9090;
            proxy_set_header Host $http_host;
        }

        location ^~ /admin/spark/ {
            set $sm http://spark-master:8080;
            rewrite ^/admin/spark/(.*)$ /$1 break;
            proxy_pass $sm;
            proxy_set_header Host $http_host;
            # Spark buduje adresy z reverseProxyUrl; przepisujemy je na względne, żeby działały pod dowolnym hostem i portem
            proxy_set_header Accept-Encoding "";
            sub_filter_once off;
            sub_filter_types text/html text/css application/javascript;
            sub_filter 'https://${PUBLIC_HOST}/admin/spark' '/admin/spark';
            proxy_redirect https://${PUBLIC_HOST}/admin/spark/ /admin/spark/;
        }

        # Interfejs NameNode (przeglądanie katalogów, DataNode'y); używa ścieżek bezwzględnych, więc przepisujemy je na /admin/hdfs/
        location ^~ /admin/hdfs/ {
            set $nn http://namenode:9870;
            rewrite ^/admin/hdfs/(.*)$ /$1 break;
            proxy_pass $nn;
            proxy_set_header Host $http_host;
            proxy_set_header Accept-Encoding "";
            sub_filter_once off;
            sub_filter_types text/html text/css application/javascript;
            sub_filter 'href="/' 'href="/admin/hdfs/';
            sub_filter 'src="/' 'src="/admin/hdfs/';
            sub_filter '"/jmx?' '"/admin/hdfs/jmx?';
            sub_filter "'/jmx?" "'/admin/hdfs/jmx?";
            sub_filter "'/conf'" "'/admin/hdfs/conf'";
            sub_filter "'/startupProgress'" "'/admin/hdfs/startupProgress'";
            sub_filter '"/webhdfs/v1"' '"/admin/hdfs/webhdfs/v1"';
            sub_filter "'/webhdfs/v1'" "'/admin/hdfs/webhdfs/v1'";
            sub_filter '/webhdfs/v1/' '/admin/hdfs/webhdfs/v1/';
        }

        location ^~ /admin/dashboard/ {
            set $db http://dashboard:8088;
            rewrite ^/admin/dashboard/(.*)$ /$1 break;
            proxy_pass $db;
            proxy_set_header Host $http_host;
        }
    }
}

