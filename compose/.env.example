POC_PASSWORD=poc
POC_USERS=alice,bob,admin
POC_ADMINS=admin
NEO4J_PASSWORD=pocpassword
SPARK_WORKER_CORES=2
SPARK_WORKER_MEMORY=2g
USER_MEM_LIMIT=2G
USER_CPU_LIMIT=1
LDAP_ADMIN_PASSWORD=ldapadmin
HUB_ADMINS=4alice
SPARK_DEFAULT_CORES=1
USER_IDLE_TIMEOUT=900
KERNEL_IDLE_TIMEOUT=600

# Adres, na którym publikowane są porty (domyślnie wszystkie interfejsy; na serwerze współdzielonym ustaw 127.0.0.1)
#BIND_ADDR=127.0.0.1

# Bramka SSH (compose.ssh.yaml): port i adres nasłuchiwania; na serwerze współdzielonym ustaw SSH_BIND_ADDR na adres hosta, żeby udostępnić SSH w sieci
#SSH_PORT=2222
#SSH_BIND_ADDR=127.0.0.1

# Wejście HTTP/HTTPS (compose.proxy.yaml): adres nasłuchu nginx
#WEB_BIND_ADDR=127.0.0.1
# Neo4j (z Graph Data Science): pamięć
#NEO4J_HEAP=1g
#NEO4J_PAGECACHE=512m

# LDAP. Domyślnie symulacja w kontenerze (compose.ldap-demo.yaml). Prawdziwy LDAP: usuń ten plik z STACK_FILES i ustaw:
#LDAP_URI=ldaps://ldap.example.org:636
#LDAP_BASE_DN=dc=example,dc=org
#LDAP_USER_SEARCH_BASE=dc=example,dc=org   # gdzie szukać użytkowników (gdy leżą w wielu gałęziach); puste: uid=<login>,ou=people,<base>
#LDAP_BIND_DN=                             # puste: odczyt anonimowy
#LDAP_BIND_PASSWORD=
#LDAP_TLS_REQCERT=allow                    # allow: bez weryfikacji certyfikatu; demand: weryfikacja wg LDAP_CA_FILE
#LDAP_CA_FILE=/opt/spark/compose/ldap/ca.pem
#HUB_ADMINS=login            # administratorzy huba (dopuszczeni zawsze, niezależnie od grupy); to ustawienie stosu, nie LDAP-a

# HDFS (compose.hdfs.yaml): tajna nazwa superużytkownika HDFS (znają ją tylko hub i bramka); ustaw własną losową
#HDFS_ADMIN_USER=hdfsadmin

# Monitoring i panele administracyjne (compose.monitoring.yaml): nazwa hosta panelu (rekord DNS), hasło wewnętrzne Grafany,
# grupa systemowa z administratorami (poza HUB_ADMINS)
#ADMIN_HOST=admin.spark.example.org
#GRAFANA_ADMIN_PASSWORD=change-me-grafana
#ADMIN_GROUP=sparkadmins
