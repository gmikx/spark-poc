#!/usr/bin/python3
# Kto może wejść przez SSH: członkowie grupy ACCESS_GROUP na serwerze (plik group hosta) + administratorzy.
import os
import sys

sys.path.insert(0, "/usr/local/lib/spark")
from spark_provision import group_members

user = os.environ.get("PAM_USER", "")


def first_line(path):
    try:
        return open(path).read().strip()
    except OSError:
        return ""


group = first_line("/etc/spark/access_group") or "sparkusers"
admins = {a.strip() for a in open("/etc/spark/admins").read().split() if a.strip()}
allowed = group_members("/run/spark-host/etc/group", group) | admins
sys.exit(0 if user and user in allowed else 1)
